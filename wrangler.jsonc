{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spotlight-adorzia-beta",
  "compatibility_date": "2026-05-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": "./.output/public"
  },
  "observability": {
    "enabled": true
  }
}
